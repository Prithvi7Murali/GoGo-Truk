# Copy this file to .env and fill in the values
# Get these from a teammate or the Supabase/Cloudinary dashboards

# Supabase PostgreSQL — shared cloud DB (Settings → Database → Connection String → URI)
DATABASE_URL=postgresql://postgres:gogotrukisthepassword@db.zratmboagmracdyebtyb.supabase.co:5432/postgres

# Cloudinary — file storage for ID proof uploads
CLOUDINARY_CLOUD_NAME=duabdk52l
CLOUDINARY_API_KEY=668937872592566
CLOUDINARY_API_SECRET=OvtBBcnHexl-RQWd6Rxzw-MGhZc

# App secret
SECRET_KEY=gogotruk-super-secret-key-2026

# Supabase API (Settings → API → Project URL and anon public key)
SUPABASE_URL=https://zratmboagmracdyebtyb.supabase.co
SUPABASE_KEY=your-anon-key-from-supabase-dashboard

# DEV_MODE=true  → OTP auto-verified, dev_otp exposed in response, notifications logged to console
# DEV_MODE=false → enforce real OTP/SMS/email delivery (production)
DEV_MODE=true

# Notifications — only needed when DEV_MODE=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MSG91_API_KEY=
MSG91_SENDER_ID=GOTRUK

# Reporting — comma-separated emails for weekly/monthly report delivery (Story 17)
# In DEV_MODE, reports are generated but only logged to console, not emailed.
MANAGEMENT_EMAIL=management@gogotruk.com

# Admin JWT — token expires in N minutes (default 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# First-time superadmin seed — auto-created on first uvicorn startup if no superadmin exists.
# These match the UI login form's default pre-filled credentials.
# Change all three before going to production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@gogotruk.com
SEED_ADMIN_PASSWORD=admin@gogotruk

# Redis — optional, for search caching + Celery broker (Stories 10-12)
# Leave blank to disable caching and run notifications synchronously
REDIS_URL=

# Firebase Cloud Messaging — optional, for push notifications to owners (Story 12)
# Get server key from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=

# Celery worker — run separately when REDIS_URL is set:
#   celery -A app.celery_app.celery_app worker --loglevel=info
